{
  "name": "@namilux/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --config ../../packages/config/eslint.config.js --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@namilux/config": "workspace:*",
    "@namilux/core": "workspace:*",
    "@namilux/db": "workspace:*",
    "@namilux/integrations": "workspace:*",
    "@namilux/seed": "workspace:*",
    "pino": "9.14.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
