{
  "name": "@namilux/core",
  "version": "1.0.0",
  "private": true,
  "description": "NAMILUX pure domain core: persian utils, url encoding, money, sanitizer, validation schemas, settings, authz, ids, errors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./constants": "./src/constants.ts",
    "./errors": "./src/errors.ts",
    "./ids": "./src/ids.ts",
    "./types": "./src/types/index.ts",
    "./persian": "./src/persian/index.ts",
    "./url": "./src/url/index.ts",
    "./money": "./src/money/index.ts",
    "./pricing/instalments": "./src/pricing/instalments.ts",
    "./html": "./src/html/index.ts",
    "./geo": "./src/geo/provinces.ts",
    "./validation": "./src/validation/index.ts",
    "./settings": "./src/settings/index.ts",
    "./authz": "./src/authz/index.ts",
    "./cache": "./src/cache/index.ts",
    "./audit": "./src/audit.ts",
    "./security": "./src/security.ts",
    "./jobs": "./src/jobs.ts",
    "./orders/payments": "./src/orders/payments.ts"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "node -e \"console.log('@namilux/core is a library consumed from source; nothing to start')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@namilux/config": "workspace:*",
    "@namilux/db": "workspace:*",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
