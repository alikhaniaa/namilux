#
# Generate each 32-byte secret with:   openssl rand -hex 32
# Validate before starting anything:   /opt/namilux/bin/release.sh <name> check-env

# -  -  - process -  -  - 
NODE_ENV=production
# prod | staging  (staging allows mock drivers; prod refuses them)
APP_ENV=prod
LOG_LEVEL=info

# -  -  - origins (https, bare, no trailing slash; admin ≠ site) -  -  - 
SITE_ORIGIN=https://namilux.ir
ADMIN_ORIGIN=https://admin.namilux.ir
# Caddy is in front; the apps read the LAST X-Forwarded-For hop
TRUST_PROXY=1

# Main storefront: one catalog, one price, ZarinPal with optional SnappPay.
SITE_MODE=main
# -  -  - admin edge allow-list - also mirrored in /etc/caddy/namilux.env -  -  - 
# IPv4/IPv6 CIDRs, comma or space separated. Empty = no app-level list (Caddy still filters).
ADMIN_ALLOWED_CIDRS=

# -  -  - database (the spec: one role per app; passwords set by provision.sh) -  -  - 
DATABASE_URL_WEB=postgres://nl_web:CHANGE_ME@127.0.0.1:5432/namilux
DATABASE_URL_ADMIN=postgres://nl_admin:CHANGE_ME@127.0.0.1:5432/namilux
DATABASE_URL_WORKER=postgres://nl_worker:CHANGE_ME@127.0.0.1:5432/namilux
DATABASE_URL_MIGRATE=postgres://nl_migrate:CHANGE_ME@127.0.0.1:5432/namilux
# Max Postgres connections per process (1–99). Leave capacity for admin and worker.
# Empty = the driver default.
DB_POOL_MAX=

# -  -  - secrets: 64 hex chars each, all different -  -  - 
SESSION_PEPPER=
OTP_PEPPER=
QUOTE_SIGNING_KEY=
INTERNAL_SIGNING_KEY=
TOTP_ENC_KEY=

# -  -  - payment -  -  - 
# zarinpal | snapppay (mock is refused in prod)
PAYMENT_DRIVER=zarinpal
# a UUID from the ZarinPal panel; required as soon as PAYMENT_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0
# refunds - next.zarinpal.com/api/v4/graphql, a different API from the gateway: the panel OAuth token
# and the terminal id that resolves a stored ref_id back to the session id the mutation is keyed on.
# Never sent to payment.zarinpal.com; without both, a refund fails early instead of half-running.
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_TERMINAL_ID=

# SnappPay on the main website. The public crawler feed works with this flag disabled.
# Enable only after support issues credentials and the callback has been validated.
# BASE_URL/CLIENT_ID/CLIENT_SECRET/USERNAME/PASSWORD are required when enabled.
# Web, admin and worker share these credentials for payment, settlement and refunds.
SNAPPPAY_ENABLED=0
SNAPPPAY_BASE_URL=
SNAPPPAY_CLIENT_ID=
SNAPPPAY_CLIENT_SECRET=
SNAPPPAY_USERNAME=
SNAPPPAY_PASSWORD=
SNAPPPAY_CATEGORY=

# -  -  - SMS -  -  - 
# farazsms | kavenegar | smsir | melipayamak  (mock is refused in prod)
SMS_DRIVER=farazsms
SMS_API_KEY=
# the sender line, e.g. 3000505
SMS_SENDER=
# melipayamak only (it authenticates with a pair, not a key)
SMS_USERNAME=
SMS_PASSWORD=
# FarazSMS ONLY: a JSON map of template key → the pattern code approved in their panel. A free-text
# send there waits for a human moderator, so a login code sent that way arrives late or never - the
# env schema refuses to start with SMS_DRIVER=farazsms unless this carries an "otp" entry.
# Quote it if it contains a space: SMS_PATTERNS={"otp":"12345","order.paid":"12346"}
SMS_PATTERNS=
# what one segment costs; the provider does not report it, and sms_log's ledger (and the daily
# budget below) is counted from this figure
SMS_UNIT_COST_TOMAN=216
SMS_DAILY_BUDGET_TOMAN=2000000

# -  -  - media -  -  - 
STORAGE_DRIVER=fs
# served by Caddy at /media/*
MEDIA_DIR=/opt/namilux/media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# -  -  - CDN purge -  -  - 
# arvan once the CDN fronts the origin
CDN_DRIVER=none
ARVAN_API_KEY=
ARVAN_DOMAIN=

# -  -  - alerts - both or neither; api.telegram.org needs a route out of Iran (README §7) -  -  - 
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -  -  - emergency overrides (unset = the settings table decides) -  -  - 
# WARNING (6 Sep 2026, launch audit): as the code stands these two are NOT honoured by the storefront.
# `effectiveFlags(settings, env)` does read them, but the only caller that passes `env` - 
# apps/web/src/server/loaders/settings.ts `loadFlags()` - is never called; the checkout page
# (app/(site)/billing/page.tsx) and core's `placeOrder` both call `effectiveFlags(settings, {})`.
# So the switch that actually closes the shop is the ADMIN SETTING commerce.checkout_enabled
# (admin → /settings/commerce → «فعال بودن خرید آنلاین»), which every process picks up within 30 s.
# See docs/launch-runbook.md; fix these lines' status when apps/web is corrected.
# CHECKOUT_ENABLED=0
# MAINTENANCE=1
SW_KILL=0

# -  -  - set by release.sh at build time (never edit by hand) -  -  - 
NEXT_PUBLIC_BUILD_ID=

# -  -  - backups (infra/server/backup.sh; the worker's backup.report reads the status file) -  -  - 
BACKUP_STATUS_PATH=/opt/namilux/backup-status.json
# age1… public key; the private key lives OFFLINE
BACKUP_AGE_PUBLIC_KEY=
# e.g. arvan:namilux-backups - empty = local retention only
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
