# -  -  - NAMILUX environment -  -  - 
# Copy to .env.local for dev. Production: /srv/namilux/.env (chmod 600). Never commit real values.

NODE_ENV=development
APP_ENV=dev                      # dev | staging | prod
LOG_LEVEL=info

# Canonical origins (must be https in prod - CSP upgrade-insecure-requests, seals, SW scope)
SITE_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3100
ADMIN_TOTP_DISABLED=0            # Temporary owner-approved test server only; rejected in prod.
TRUST_PROXY=0                    # 1 behind Caddy/CDN (x-forwarded-for / -proto)

# Main storefront: one catalog, one price, ZarinPal with optional SnappPay.
SITE_MODE=main
# Where the admin and the worker reach a storefront's /api/internal/* routes. Caddy answers 404 for
# that path on the public hostname, so the cache flip goes straight to the Next process over
# loopback; the public origin above still travels in the Host/X-Forwarded-* headers. Defaults below.
WEB_INTERNAL_URL=http://127.0.0.1:3000

# Postgres - one URL per role (packages/db/roles.sql). Dev may point all four at the same superuser.
DATABASE_URL_WEB=postgres://nl_web:nl_web@localhost:5432/namilux
DATABASE_URL_ADMIN=postgres://nl_admin:nl_admin@localhost:5432/namilux
DATABASE_URL_WORKER=postgres://nl_worker:nl_worker@localhost:5432/namilux
DATABASE_URL_MIGRATE=postgres://nl_migrate:nl_migrate@localhost:5432/namilux
DATABASE_URL_TEST=postgres://nl_migrate:nl_migrate@localhost:5432/namilux_test
# Max Postgres connections per process (1–99). Leave capacity for admin and worker.
# Empty = the driver default.
DB_POOL_MAX=

# Secrets - 32 random bytes each, hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PEPPER=
OTP_PEPPER=
QUOTE_SIGNING_KEY=
INTERNAL_SIGNING_KEY=
TOTP_ENC_KEY=

# Payments - the default gateway. A shopper may still pick the other at checkout if it is configured.
PAYMENT_DRIVER=mock              # mock | zarinpal | snapppay
ZARINPAL_MERCHANT_ID=            # 36-char UUID from the ZarinPal panel
ZARINPAL_SANDBOX=0
ZARINPAL_ACCESS_TOKEN=           # refunds - OAuth token for next.zarinpal.com (GraphQL)
ZARINPAL_TERMINAL_ID=            # refunds - terminal id, resolves a ref_id to a session id

# SnappPay on the main website. The public crawler feed works with this flag disabled.
# Enable only after support issues credentials and the callback has been validated.
# BASE_URL/CLIENT_ID/CLIENT_SECRET/USERNAME/PASSWORD are required when enabled.
# Web, admin and worker share these credentials for payment, settlement and refunds.
SNAPPPAY_ENABLED=0
SNAPPPAY_BASE_URL=               # e.g. https://api.snapppay.ir
SNAPPPAY_CLIENT_ID=              # OAuth client id from their panel
SNAPPPAY_CLIENT_SECRET=          # OAuth client secret
SNAPPPAY_USERNAME=               # merchant user
SNAPPPAY_PASSWORD=               # merchant password
SNAPPPAY_CATEGORY=               # merchant product category their panel assigns

# SMS - OTP goes through this driver synchronously
SMS_DRIVER=mock                  # mock | kavenegar | smsir | melipayamak | farazsms
SMS_API_KEY=                     # farazsms: the panel key sent as the Api-Key header
SMS_SENDER=                      # sender line (farazsms: line_number, e.g. 90008361)
SMS_USERNAME=                    # melipayamak only
SMS_PASSWORD=                    # melipayamak only
SMS_OTP_TEMPLATE=                # kavenegar/smsir/melipayamak OTP template id
SMS_DAILY_BUDGET_TOMAN=2000000
SMS_UNIT_COST_TOMAN=1500         # price per segment, for the daily budget ledger

# FarazSMS patterns - template key → the pattern code from their panel. A free-text send on FarazSMS
# waits for a human moderator, so every transactional message needs a registered pattern; the "otp"
# entry is REQUIRED (the process refuses to start without it). The pattern's variable names must
# match our placeholders - see the table in README.md.
# SMS_PATTERNS={"otp":"xxxxxxxx","order.placed_pending":"...","order.paid":"...","customer.welcome":"..."}
SMS_PATTERNS=

# Media / storage
STORAGE_DRIVER=fs                # fs | s3
MEDIA_DIR=./.media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# CDN purge (worker)
CDN_DRIVER=none                  # none | arvan
ARVAN_API_KEY=
ARVAN_DOMAIN=namilux.ir

# Owner notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Emergency overrides (settings win unless these are set)
CHECKOUT_ENABLED=
MAINTENANCE=
SW_KILL=0

# Build
NEXT_PUBLIC_BUILD_ID=dev
