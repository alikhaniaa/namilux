# local credentials and generated runtime state - never commit
KEYS/
# The mock SMS driver writes its outbox beside whichever app ran it (registry.ts:
# `join(MEDIA_DIR, "..", ".sms-outbox.jsonl")`), so the rule cannot name one directory - 
# apps/worker/.sms-outbox.jsonl reached a commit, carrying seeded phone numbers and message
# bodies, while only packages/seed's copy was ignored.
.sms-outbox.jsonl
packages/tokens/fonts/.build/
apps/web/public/media/
apps/admin/public/media/

# media / binary reference assets - never committed
data/extract/04_catalog/products/*/images/
_legacy/namilux-v1/public/images/

